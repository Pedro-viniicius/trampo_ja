# Variáveis da API. Para uso local: cp .env.example .env (dentro de apps/api).
# O .env é carregado pelos scripts e testes; variáveis já exportadas no shell têm prioridade.
# Os valores abaixo são só do Postgres local do docker-compose.yml (raiz do repositório).
# Nunca use esta senha fora da máquina de desenvolvimento.

# Banco de desenvolvimento (servidor e `pnpm --filter api migrar`).
DATABASE_URL=postgres://trampoja:trampoja_local@localhost:5432/trampoja

# Banco dos testes de integração (`pnpm test:integracao`); o nome precisa terminar em _teste.
DATABASE_URL_TESTE=postgres://trampoja:trampoja_local@localhost:5432/trampoja_teste

# Porta HTTP da API (padrão 3000).
PORT=3000

# Proxies confiáveis para o IP do cliente (X-Forwarded-For), que é a chave do rate limit.
# Vazio (padrão): desligado, vale o IP da conexão. Atrás de proxy reverso ou balanceador,
# liste os IPs/CIDRs do proxy separados por vírgula (ex.: 10.0.0.1,10.0.1.0/24).
# `true` confia em qualquer origem: só é seguro quando nada além do proxy alcança a porta
# da API (senão qualquer cliente forja o IP e escapa do limite).
TRUST_PROXY=
