{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/servidor.js",
    "migrar": "tsx scripts/migrar.ts",
    "semear": "tsx scripts/semear.ts",
    "test": "vitest run --config vitest.config.ts",
