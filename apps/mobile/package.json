{
  "name": "mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "typecheck": "EXPO_NO_TELEMETRY=1 expo customize tsconfig.json && tsc --noEmit",
    "lint": "biome check .",
    "build": "expo export --platform android --clear --output-dir dist",
    "build:producao": "TRAMPOJA_BUILD=producao expo export --platform android --clear --output-dir dist"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/figtree": "0.4.1",
    "@expo/metro-runtime": "58.0.17",
    "@expo/vector-icons": "15.1.1",
    "@tanstack/react-query": "5.104.5",
    "expo": "58.0.25",
    "expo-constants": "58.0.16",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.12",
    "expo-linear-gradient": "58.0.4",
    "expo-linking": "58.0.17",
    "expo-network": "58.0.5",
    "expo-router": "58.0.31",
    "expo-secure-store": "58.0.3",
    "expo-sharing": "58.0.23",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "setupFiles": [
      "<rootDir>/src/testes/setup-jest.ts"
    ]
  }
}
