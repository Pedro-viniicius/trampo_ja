{
  "name": "mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "build": "expo export --platform android --clear --output-dir dist",
    "build:producao": "TRAMPOJA_BUILD=producao expo export --platform android --clear --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.17",
    "@expo/vector-icons": "15.1.1",
    "@tanstack/react-query": "5.104.5",
    "expo": "57.0.30",
    "expo-constants": "57.0.22",
    "expo-file-system": "57.0.7",
    "expo-linear-gradient": "57.0.2",
    "expo-linking": "57.0.13",
    "expo-network": "57.0.2",
    "expo-router": "57.0.28",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.24",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "setupFiles": [
      "<rootDir>/src/testes/setup-jest.ts"
    ]
  }
}
